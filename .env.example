# Copy to `.env` and fill in real values (never commit `.env`).

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# API base URL (include trailing /api/). Endpoint paths are relative to this.
BASE_URL=https://api.hudhuddelivery.com/api/

# Optional App Store country code for iOS version lookup (e.g. et, us, sa).
# APP_STORE_COUNTRY=et

# Set to true to exercise force-update during debug/profile runs.
# FORCE_UPDATE_IN_DEBUG=true
