# Copy to `.env` and fill in real values (never commit `.env`).
#
# `.env` is bundled as a Flutter asset and read at runtime (BASE_URL), and by
# the native builds (GOOGLE_MAPS_API_KEY). Plain `flutter run` is enough.
# The file must exist for the build to succeed (it is a declared asset).

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# API base URL (include /api). An explicit --dart-define=BASE_URL=... overrides it.
BASE_URL=https://deliveryapi.hudhudexpress.com/api/

# Other Dart-side settings are still compile-time defines:
#   --dart-define=APP_STORE_COUNTRY=et                            (optional)
#   --dart-define=FORCE_UPDATE_IN_DEBUG=true                      (debug only)
# See README.md.
