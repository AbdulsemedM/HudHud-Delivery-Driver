# Copy to `.env` and fill in real values (never commit `.env`).
#
# `.env` is bundled as a Flutter asset and read at runtime (BASE_URL), and by
# the native builds (GOOGLE_MAPS_API_KEY). Plain `flutter run` is enough.
# The file must exist for the build to succeed (it is a declared asset).

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# The SECOND Google key, and it must be a different one.
#
# Everything fetched from maps.googleapis.com over HTTPS - Places autocomplete,
# place details, Geocoding, Directions - reads this key instead. Google applies
# "Android apps" application restrictions to the Maps SDKs ONLY; the web-service
# endpoints reject a key carrying one with REQUEST_DENIED. So this key's
# Application restriction must be None, narrowed the other way instead: API
# restriction limited to Places API, Geocoding API and Directions API, with
# daily quota caps set per API.
#
# Blank falls back to GOOGLE_MAPS_API_KEY, which is what the app did before the
# split - safe only while that key is unrestricted.
GOOGLE_MAPS_WEB_KEY=your_google_maps_web_services_key_here

# API base URL (include /api). An explicit --dart-define=BASE_URL=... overrides it.
BASE_URL=https://api.hudhuddelivery.com/api/

# Other Dart-side settings are still compile-time defines:
#   --dart-define=APP_STORE_COUNTRY=et                            (optional)
#   --dart-define=FORCE_UPDATE_IN_DEBUG=true                      (debug only)
# See README.md.
