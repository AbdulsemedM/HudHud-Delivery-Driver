# Copy to `.env` and fill in real values (never commit `.env`).
#
# `.env` is read ONLY at native build time (android/app/build.gradle and
# ios/Flutter/sync_maps_key_from_env.sh). It is NOT bundled into the app.

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Dart-side settings are compile-time defines, not `.env` values:
#   --dart-define=BASE_URL=https://api.hudhuddelivery.com/api/   (default)
#   --dart-define=APP_STORE_COUNTRY=et                            (optional)
#   --dart-define=FORCE_UPDATE_IN_DEBUG=true                      (debug only)
# See README.md.
